# Copiar este archivo como .env y cambiar los valores.
# El archivo .env NUNCA se sube al repositorio.

# --- Base de datos (PostgreSQL 16) ---
DB_NAME=upbconecta
DB_USER=upbconecta
DB_PASSWORD=cambiar_esta_contrasena
DB_PORT=5432

# --- Backend (Spring Boot) ---
# Orígenes que pueden llamar a la API, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# update en desarrollo; validate cuando haya migraciones
JPA_DDL_AUTO=update

# --- Frontend (React + Vite) ---
VITE_API_URL=http://localhost:8080/api/v1
