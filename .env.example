# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upbconecta
DB_USER=upbconecta_user
DB_PASSWORD=upbconecta_password_2026

# Spring Boot
JPA_DDL_AUTO=update
SERVER_PORT=8080
AZURE_TENANT_ID=your-microsoft-tenant-id
AZURE_CLIENT_ID=your-microsoft-application-client-id
# Replace with the output of: openssl rand -base64 32
JWT_SECRET=

# CORS (origins separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Modo demo (true solo en desarrollo, false en produccion)
DEMO_ENABLED=false
COOKIE_SECURE=false

# Frontend (URL que el NAVEGADOR usa para llamar al backend)
VITE_API_URL=http://localhost:8080/api/v1
VITE_AZURE_TENANT_ID=your-microsoft-tenant-id
VITE_AZURE_CLIENT_ID=your-microsoft-application-client-id