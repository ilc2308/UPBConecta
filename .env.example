# ========================================================
# UPB Conecta - Variables de Entorno (Plantilla)
# Copiar este archivo como .env y configurar las credenciales
# ========================================================

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=upbconecta
DB_USER=upbconecta_user
DB_PASSWORD=upbconecta_password_2026

# JPA / Hibernate (update en desarrollo, validate en produccion)
JPA_DDL_AUTO=update

# Seguridad y CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# URL de la API consumida por el Frontend
VITE_API_URL=http://localhost:8080/api/v1